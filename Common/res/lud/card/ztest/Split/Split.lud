(define "PlayACard"
    (move
        (from (sites Hand Mover))
        (to (sites Occupied by:All)
            if:(or
                (is Empty (to))
                (is Empty (from))
            )
        )
        stack:True
    )
)
(define "PlayHigh"
    (move
        (from Cell (sites Hand Mover)  if:(isMaxAttribute (from) "Value"))
        (to Vertex 1)
        stack:True
    )
)
(define "PlayLow"
    (move
        (from Cell (sites Hand Mover) if:(isMinAttribute (from) "Value"))
        (to Vertex 0)
        stack:True
    )
)
(define "PlayHighAndLow"
    (do ("PlayHigh") next:("PlayLow"))
)
(game "Split"
    (players 2)
    (equipment {
        (cardTable 2)
        (hand Each size:9)
        (hand Shared size:1)
        ("SplitCards")
    })
    (rules
        (start {
            (deal Cards 9 P1)
            (deal Cards 7 P2)
            (deal Deck 10)
        })
        phases:{
        (phase "Start1"
            (play
                ("PlayHighAndLow")
            )
            (nextPhase True "Play1")
        )
        (phase "Play1"
            (play
                (move Pass)
            )
            (nextPhase False "Start1")
        )
        }

        (end
            (if ("HandEmpty" P2)
                (result P2 Win)
            )
        )
    )
)
