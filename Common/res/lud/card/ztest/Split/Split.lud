(define "PlayACard"
    (move
        (from Cell (sites Hand Mover))
        (to Vertex 0
            if:(and
                (< (value CardType "Value" at:1) (value CardType "Value" at:(from)))
                (> (value CardType "Value" at:2) (value CardType "Value" at:(from)))
            )
        )
        stack:True
    )
)
(define "PlayHigh"
    (move
        (from Cell (sites Hand Mover)  if:(isMaxAttribute (from) "Value"))
        (to Vertex 2)
        stack:True
    )
)
(define "PlayLow"
    (fromTo
        (from Cell (sites Hand Mover) if:(isMinAttribute (from) "Value"))
        (to Vertex 1)
        stack:True
    )
)
(define "PlayHighAndLow"
    (do ("PlayHigh") next:("PlayLow"))
)

(define "ChooseWhereToPlay"
    (move
        (from Vertex 0)
        (to Vertex (sites {1 2}))
        stack:True
        (then (moveAgain))
    )
)
(define "ResetTheGame"
    (move
        (from Vertex 1)
        (to Cell 21 level:0)
        stack:True
    )

)
(game "Split"
    (players 2)
    (equipment {
        (cardTable 3 False)
        (hand Each size:9)
        (hand Shared size:1)
        ("SplitCards")
    })
    (rules
        (start {
            (deal Cards 9 P1)
            (deal Cards 7 P2)
            (deal Deck 10)
        })
        phases:{
            (phase "Start1"
                (play
                    ("PlayHighAndLow")
                )
                (nextPhase True "Propose1")
            )
            (phase "Propose1"
                (play
                    (or
                        ("PlayACard")
                        ("ResetTheGame")
                    )
                )
                (nextPhase True "Choose1")
            )
            (phase "Choose1"
                (play
                    ("ChooseWhereToPlay")
                )
                (nextPhase Mover True "Propose1")
            )
        }

        (end
            (if ("HandEmpty" P2)
                (result P2 Win)
            )
        )
    )
)
