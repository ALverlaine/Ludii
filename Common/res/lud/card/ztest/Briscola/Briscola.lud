
(define "StrongestCard"
        (if (is Empty 0)
            (set CardType at:0)
            (if (= (CardTrumpSuit) (var "TopCard"))
                (if >
        )
)

(define "PlayCard"
    (move
        (from Cell (sites Hand Mover))
        (to Vertex 0)
        (then
            (and
                {
                (set Pot (+ (value Pot) (value CardType "Rank" at:0)))
                (set Var "CardPlayed" (+ (var "CardPlayed") 1))
                ("StrongestCard")
                }
            )
        )
    )
)

(game "Briscola"
    (players 4)
    (equipment {
        (cardTable 2)
        ("BriscolaCards")  // Jeu de 40 cartes (sans 8, 9, 10)
        (hand Each size:9)  // Main de chaque joueur
        (hand Shared size:1)
    })

    (rules
        (start {
            (set Var "CardPlayed" 0)
            (deal Cards 3 P1)  // Distribuer 3 cartes à chaque joueur
            (deal Cards 3 P2)  // Distribuer 3 cartes à chaque joueur
            (deal Cards 3 P3)  // Distribuer 3 cartes à chaque joueur
            (deal Cards 3 P4)  // Distribuer 3 cartes à chaque joueur
            (deal Deck 10 stack:True)
            (set Trump (value CardType "Suit" at:38))  // Retourner la carte d'atout
        })
        phases:{
            (phase "Play"
                (play
                        ("PlayCard")
                )
                (nextPhase (= 4 (var "CardPlayed")) "CountPoint")
            )
            (phase "CountPoint"
                (play
                        (move Pass)
                )
                (nextPhase False "Play")
            )
        }
        (end
            (if ("HandEmpty" Mover) (result Mover Win))
        )
    )
)
