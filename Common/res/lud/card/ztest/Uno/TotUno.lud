(define "HandEmpty" (all Sites (sites Hand #1) if:(= 0 (count Cell at:(site)))) )
(game "TotUno"
    (players 2)
    (equipment {
        (cardTable 2 largeStack:False)
        (hand Each size:5)
        (hand Shared size:1)
        (unoCards)
    })
    (rules
        (start {
            (deal Cards 5 All)
            (deal Deck 5)
        })
        (play (or {
                (move
                    (from
                        (sites Hand Mover)
                        if:(is Occupied (from)
                        )
                    )
                    (to (sites Occupied by:All)
                        if:(or
                            (=
                                (value CardType "Color" at:(from))
                                (value CardType "Color" at:0 level:(topLevel at:0))
                            )
                            (=
                                (value CardType "Number" at:(from))
                                (value CardType "Number" at:0 level:(topLevel at:0))
                            )
                        )
                    )
                    stack:True
                )
                (move (from (sites Hand Mover) if:(is Occupied (from))) (to 0 if:(is Empty 0)) stack:True)
                (move (from (handSite Shared)) (to (sites Hand Mover) if:(is Empty (to))))
        }))
        (end
            (if ("HandEmpty" Mover) (result Mover Win))
        )
    )
)
(metadata
    (graphics
    {
        (stackType None)  // Active le stacking des cartes
        }
    )
)