
(define "NPlayer"
    (set NextPlayer (player (+ 1 (% (+ 1  (mover)) 3))))
)
(define "PlayNumber"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "Value"))
        (to Vertex 0 if:(>= 21 (+ (value CardType "Value" at:(from)) (value Pot))))
        (then (set Pot (+ (value Pot) (value CardType "Value" at:0))))
    )
)
(define "Play+1"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "+1"))
        (to Vertex 0)
        (then
            (and
                {
                (fromTo
                    (from Cell 28 if:(is Occupied (from)))
                    (to Cell (sites Hand P1) if:(and (is Empty (to)) (not (= 9 (to)))))
                )
                (fromTo
                    (from Cell 28 if:(is Occupied (from)))
                    (to Cell (sites Hand P2) if:(and (is Empty (to)) (not (= 18 (to)))))
                )
                (fromTo
                    (from Cell 28 if:(is Occupied (from)))
                    (to Cell (sites Hand P3) if:(and (is Empty (to)) (not (= 27 (to)))))
                )
                }
            )
        )
    )
)
(define "Play0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "=0"))
        (to Vertex 0)
        (then
            (set Pot 0)
        )
    )
)
(define "PlayA0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "0"))
        (to Vertex 0)
    )
)
(define "Play10"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "=10"))
        (to Vertex 0)
        (then
            (set Pot 10)
        )
    )
)
(define "Play21"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "=21"))
        (to Vertex 0)
        (then
            (set Pot 21)
        )
    )
)

(define "Pass0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "Pass"))
        (to Vertex 0)
    )
)

(define "Jump0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "Jump"))
        (to Vertex 0)
        (then (set NextPlayer (player (% (+ 2 (mover)) 3))))
    )
)
(define "Inversion0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "Inversion"))
        (to Vertex 0)
        (then
            (or
                (if (= 0 (var "InversionVar")) (set Var "InversionVar" 1 (then ("NPlayer"))))
                (if (= 1 (var "InversionVar")) (set Var "InversionVar" 0 (then (set NextPlayer (player (+ 1 (% (mover) 3)))))))
            )
            
        )
    )
)
(define "Bomb0"
    (move
        (from Cell (sites Hand Mover) if:(hasAttribute (from) "Bomb"))
        (to Vertex 0)
        (then
            (set Var "Bo" 1)
        )
    )
)

(game "5Alive"
    (players 3)
    (equipment {
        (cardTable 1)
        (hand Each size:9)
        (hand Shared size:1)
        ("5AliveCards")
        ("5AliveCardsLive")
    })
    (rules
        (start {
            (set Var "InversionVar" 0)
            (deal Cards 7 P1 deckType:"Card")
            (deal Cards 7 P2 deckType:"Card")
            (deal Cards 7 P3 deckType:"Card")
            (deal Deck 10 28 stack:True deckType:"Card")
        })
        phases:{
            (phase "basic"
                (play
                    (do
                        (if (= 1 (var "InversionVar")) ("NPlayer"))
                        next:(or
                            {
                            ("PlayNumber")
                            ("Play+1")
                            ("Play0")
                            ("Play10")
                            ("Play21")
                            ("Pass0")
                            ("Jump0")
                            ("Inversion0")
                            ("Bomb0")
                            }
                        )
                    )
                )
                (nextPhase (= 1 (var "Bo")) "BombP0")

            )
            (phase "BombP0"
                (play
                    (do
                        (if (= 1 (var "InversionVar")) ("NPlayer"))
                        next:
                            (and
                                ("PlayA0")
                                (set Var "Bo" (+ 1 (var "Bo")))
                            )
                    )
                )
                (nextPhase (= 3 (var "Bo")) "basic")
            )
        }

        (end
            ("NoMoves" Loss)
        )
    )
)
