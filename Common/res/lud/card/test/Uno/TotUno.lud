(define "HandEmpty" (all Sites (sites Hand #1) if:(= 0 (count Cell at:(site)))) )
(game "TotUno"
    (players 2)
    (equipment {
        (cardTable 2)
        (hand Each size:5)
        (hand Shared size:1)
        (unoCards)
    })
    (rules
        (start {
            (deal Cards 5)
            (deal Deck 5)
        })
        (play (or {
                (move
                    (from
                        (sites Hand Mover)
                        if:(is Occupied (from)
                        )
                    )
                    (to (sites Occupied by:All)
                        if:(or
                            (=
                                (value CardType "Color" at:(from))
                                (value CardType "Color" at:(to))
                            )
                            (=
                                (value CardType "Number" at:(from))
                                (value CardType "Number" at:(to))
                            )
                        )
                    )
                    stack:true
                )
                (move (from (sites Hand Mover) if:(is Occupied (from))) (to (sites Empty)) stack:true)
                (move (from (handSite Shared)) (to (sites Hand Mover) if:(is Empty (to))))
        }))
        (end
           (if ("HandEmpty" Mover) (result Mover Win))
        )
    )
)
