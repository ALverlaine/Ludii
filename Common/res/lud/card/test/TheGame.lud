(define "PlayACard"
    (move
        (from (sites Hand #1))
        (to #2)
        #3
        #4
    )
)

(game "TheGame"
    (players 2)
    (equipment {
        (cardTable 4)
        (hand Each size:7)
        (hand Shared size:1)
        ("TheGameCards")
    })
    (rules
        (start {
            (place "1" 0)
            (place "1" 1)
            (place "99" 2)
            (place "99" 3)
            (deal Cards 7)
            (deal Deck 10 stack:True)
        })
        (play
            (or
                (if (= (value CardType "Value" at:(site)) ) ("PlayACard" Mover 0))
                (move Pass)
            )
        )
        (end
            (if ("HandEmpty")
                (result Mover Win)
            )
        )
    )
)
